<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">

<title>Know Your Chain of Command</title>

<style>
:root{
  --navy:#132b3d;
  --blue:#3f78ad;
  --blue2:#2b577f;
  --bg:#f5f8fb;
  --white:#fff;
  --border:#c8d9e7;
  --text:#193148;
  --muted:#66798a;
  --gold:#d4af37;
  --silver:#aeb7c2;
  --bronze:#a66a3f;
  --wood:#805333;
  --clear:#dff7ff;
  --shadow:0 8px 28px rgba(19,43,61,.10);
  --radius:14px;
  --max:1200px;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.55;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:#fff;
  border-bottom:1px solid var(--border);
}

.header-inner{
  max-width:var(--max);
  margin:auto;
  padding:16px 22px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  text-decoration:none;
  color:var(--navy);
}

.brand-title{
  display:block;
  font-size:1.35rem;
  font-weight:900;
  letter-spacing:-.04em;
}

.brand-subtitle{
  display:block;
  color:var(--muted);
  font-size:.68rem;
  text-transform:uppercase;
  letter-spacing:.1em;
}

nav{
  display:flex;
  gap:20px;
}

nav button{
  border:0;
  background:transparent;
  color:var(--text);
  font-weight:700;
}

.hero{
  background:linear-gradient(135deg,var(--navy),var(--blue));
  color:#fff;
  text-align:center;
  padding:65px 20px 85px;
}

.hero-inner{
  max-width:850px;
  margin:auto;
}

.eyebrow{
  text-transform:uppercase;
  letter-spacing:.16em;
  font-size:.75rem;
  font-weight:800;
  opacity:.8;
}

.hero h1{
  margin:12px 0;
  font-size:clamp(2.7rem,7vw,5rem);
  line-height:.98;
  letter-spacing:-.06em;
}

.hero p{
  max-width:680px;
  margin:20px auto 0;
  font-size:1.1rem;
  opacity:.92;
}

.search-wrapper{
  margin-top:-40px;
  padding:0 20px;
  position:relative;
  z-index:5;
}

.search-card{
  max-width:900px;
  margin:auto;
  padding:28px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}

.search-card h2{
  margin:0 0 5px;
}

.search-card p{
  margin-top:0;
  color:var(--muted);
}

.address-form{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr auto;
  gap:10px;
}

.address-form input{
  min-width:0;
  padding:14px 16px;
  border:2px solid var(--border);
  border-radius:9px;
  outline:none;
}

.address-form input:focus{
  border-color:var(--blue);
}

.primary{
  border:0;
  border-radius:9px;
  padding:14px 20px;
  color:#fff;
  background:var(--blue);
  font-weight:800;
}

.primary:hover{
  background:var(--blue2);
}

.status{
  max-width:900px;
  margin:20px auto;
  padding:13px 17px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:9px;
}

.status.error{
  background:#fff5f5;
  border-color:#dfb8b8;
  color:#9b3f3f;
}

main{
  max-width:var(--max);
  margin:auto;
  padding:55px 20px 80px;
}

.section-heading{
  margin-bottom:25px;
}

.section-heading h2{
  margin-bottom:5px;
  font-size:2rem;
}

.section-heading p{
  margin:0;
  color:var(--muted);
}

.map-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  overflow:hidden;
}

.map-head{
  padding:20px 22px;
  border-bottom:1px solid var(--border);
}

.map-head h3{
  margin:0;
  font-size:1.35rem;
}

.map-head p{
  margin:5px 0 0;
  color:var(--muted);
}

.map-wrap{
  padding:14px;
  background:#f8fbfd;
  overflow:hidden;
}

#mapContainer{
  width:100%;
  min-height:450px;
}

#mapContainer svg{
  display:block;
  width:100%;
  height:auto;
  max-height:650px;
}

#mapContainer svg path[id]{
  vector-effect:non-scaling-stroke;
}

#mapContainer svg path.state-clickable{
  fill:#dfeaf2 !important;
  stroke:#fff !important;
  stroke-width:1.2 !important;
  cursor:pointer !important;
  pointer-events:all !important;
  transition:fill .12s,filter .12s;
}

#mapContainer svg path.state-clickable:hover{
  fill:#79a9cf !important;
  filter:drop-shadow(0 2px 2px rgba(0,0,0,.15));
}

#mapContainer svg path.state-clickable.selected{
  fill:#3f78ad !important;
  filter:drop-shadow(0 3px 4px rgba(19,43,61,.25));
}

#mapContainer svg path.state-clickable.zip-selected{
  fill:#d4af37 !important;
}

.map-help{
  padding:14px 18px;
  background:#fff;
  border-top:1px solid var(--border);
  font-weight:700;
  color:var(--muted);
  text-align:center;
}

.location-result{
  display:none;
  margin-top:16px;
  padding:18px;
  background:#fff;
  border:2px solid var(--blue);
  border-radius:12px;
}

.location-result.show{
  display:block;
}

.state-panel{
  display:none;
  margin-top:35px;
  margin-bottom:65px;
  padding:30px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}

.state-panel.visible{
  display:block;
}

.state-panel-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  margin-bottom:25px;
}

.state-code{
  color:var(--blue);
  font-weight:900;
  letter-spacing:.1em;
}

.state-title{
  margin:0;
  font-size:2.2rem;
}

.close-state{
  border:0;
  background:var(--bg);
  color:var(--text);
  border-radius:8px;
  padding:8px 13px;
}

.gov-tabs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  margin-bottom:25px;
  padding-bottom:5px;
}

.gov-tab{
  white-space:nowrap;
  border:1px solid var(--border);
  background:#fff;
  color:var(--text);
  border-radius:999px;
  padding:9px 15px;
  font-weight:750;
}

.gov-tab.active{
  background:var(--blue);
  border-color:var(--blue);
  color:#fff;
}

.official-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
  gap:20px;
}

.official-card{
  overflow:hidden;
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  transition:.2s;
}

.official-card:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow);
}

.photo-frame{
  height:190px;
  padding:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#e9eef3;
}

.photo-inner{
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:2.7rem;
  font-weight:900;
  color:var(--navy);
  background:linear-gradient(135deg,#dce8f2,#a8c2da);
  overflow:hidden;
}

.photo-inner img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.frame-gold{
  border:10px solid var(--gold);
}

.frame-silver{
  border:10px solid var(--silver);
}

.frame-bronze{
  border:10px solid var(--bronze);
}

.frame-wood{
  border:11px solid var(--wood);
}

.frame-clear{
  border:5px solid rgba(150,210,230,.9);
}

.official-body{
  padding:20px;
}

.office{
  color:var(--blue);
  text-transform:uppercase;
  font-size:.72rem;
  font-weight:900;
  letter-spacing:.08em;
}

.official-name{
  margin:5px 0;
  font-size:1.3rem;
}

.district{
  margin:0 0 15px;
  color:var(--muted);
}

.party{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:5px 10px;
  background:var(--bg);
  border-radius:999px;
  font-size:.75rem;
  font-weight:750;
}

.party-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#718594;
}

.tier{
  display:inline-block;
  margin-top:10px;
  padding:4px 9px;
  border-radius:6px;
  font-size:.7rem;
  font-weight:850;
}

.tier-gold{
  background:#fbf2c7;
  color:#806700;
}

.tier-silver{
  background:#edf0f3;
  color:#5f6872;
}

.tier-bronze{
  background:#f0dfd3;
  color:#77472d;
}

.tier-wood{
  background:#ead9cb;
  color:#633d25;
}

.tier-clear{
  background:#e4f8fd;
  color:#387185;
}

.official-footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:18px;
  padding-top:14px;
  border-top:1px solid var(--border);
  gap:10px;
}

.profile-button{
  border:0;
  background:transparent;
  color:var(--blue);
  font-weight:800;
}

.frame-legend{
  margin-top:30px;
  padding:22px;
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:var(--radius);
}

.legend-grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:10px;
}

.legend-item{
  padding:12px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:9px;
  text-align:center;
  font-size:.8rem;
  font-weight:750;
}

.legend-swatch{
  height:12px;
  margin-bottom:8px;
  border-radius:4px;
}

.swatch-gold{background:var(--gold)}
.swatch-silver{background:var(--silver)}
.swatch-bronze{background:var(--bronze)}
.swatch-wood{background:var(--wood)}
.swatch-clear{
  background:var(--clear);
  border:1px solid #9ed7e5;
}

.power-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:15px;
}

.power-card{
  padding:20px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
}

.power-card h3{
  margin:8px 0 5px;
}

.power-card p{
  margin:0;
  color:var(--muted);
  font-size:.9rem;
}

.modal{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(15,28,42,.65);
  z-index:500;
}

.modal.visible{
  display:flex;
}

.modal-content{
  width:100%;
  max-width:650px;
  max-height:90vh;
  overflow-y:auto;
  padding:30px;
  background:#fff;
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}

.modal-header{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.modal-close{
  width:38px;
  height:38px;
  border:0;
  border-radius:50%;
  background:var(--bg);
}

.modal-frame-preview{
  width:150px;
  height:150px;
  margin:15px 0;
}

footer{
  background:#0f1c2a;
  color:#d1e0ee;
  padding:45px 20px;
}

.footer-inner{
  max-width:var(--max);
  margin:auto;
}

footer h2{
  color:#fff;
}

footer p{
  max-width:750px;
  color:#a9bfd0;
}

@media(max-width:1000px){
  .address-form{
    grid-template-columns:1fr 1fr;
  }

  .address-form button{
    grid-column:1/-1;
  }

  .legend-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:600px){
  nav{
    display:none;
  }

  .address-form{
    grid-template-columns:1fr;
  }

  .address-form button{
    grid-column:auto;
  }

  .state-panel{
    padding:20px;
  }

  .legend-grid{
    grid-template-columns:1fr;
  }

  .map-wrap{
    padding:5px;
  }
}
</style>
</head>

<body>

<header>
  <div class="header-inner">
    <a href="#" class="brand">
      <span class="brand-title">KNOW YOUR CHAIN OF COMMAND</span>
      <span class="brand-subtitle">Civic information made understandable</span>
    </a>

    <nav>
      <button onclick="scrollToMap()">Map</button>
      <button onclick="scrollToSearch()">Find My Government</button>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <div class="eyebrow">United States civic directory</div>
    <h1>Know Your Chain of Command</h1>
    <p>
      Explore every state, understand the levels of government,
      and find the officials connected to your location.
    </p>
  </div>
</section>

<section class="search-wrapper" id="search">

  <div class="search-card">

    <h2>Find Your Government</h2>

    <p>
      Enter your address so the Google Civic Information API can
      identify the government offices and officials serving that location.
    </p>

    <form class="address-form" id="addressForm">

      <input
        id="streetInput"
        type="text"
        autocomplete="street-address"
        placeholder="Street address"
        required
      >

      <input
        id="cityInput"
        type="text"
        autocomplete="address-level2"
        placeholder="City"
        required
      >

      <input
        id="stateInput"
        type="text"
        autocomplete="address-level1"
        maxlength="2"
        placeholder="State"
        required
      >

      <input
        id="zipInput"
        type="text"
        inputmode="numeric"
        autocomplete="postal-code"
        maxlength="5"
        placeholder="ZIP"
        required
      >

      <button class="primary" type="submit">
        FIND MY GOVERNMENT →
      </button>

    </form>

  </div>

</section>

<div id="status" class="status" hidden></div>

<main>

<section id="states">

  <div class="section-heading">
    <h2>Explore by State</h2>
    <p>Tap any state directly on the map.</p>
  </div>

  <div class="map-card">

    <div class="map-head">
      <h3>Interactive Map of the United States</h3>
      <p>
        Every state uses the real SVG map from your project.
      </p>
    </div>

    <div class="map-wrap">

      <div id="mapContainer">
        <p style="text-align:center;padding:80px 20px;color:#66798a;">
          Loading interactive map…
        </p>
      </div>

    </div>

    <div class="map-help">
      👆 Tap a state to open its government information
    </div>

  </div>

  <div id="locationResult" class="location-result"></div>

</section>

<section class="state-panel" id="statePanel">

  <div class="state-panel-header">

    <div>
      <div class="state-code" id="stateCode"></div>
      <h2 class="state-title" id="stateTitle"></h2>
    </div>

    <button class="close-state" onclick="closeState()">
      Close
    </button>

  </div>

  <div class="gov-tabs">

    <button class="gov-tab active" data-level="federal">
      Federal
    </button>

    <button class="gov-tab" data-level="state">
      State
    </button>

    <button class="gov-tab" data-level="county">
      County
    </button>

    <button class="gov-tab" data-level="local">
      City / Local
    </button>

    <button class="gov-tab" data-level="school">
      School
    </button>

    <button class="gov-tab" data-level="special">
      Special Districts
    </button>

  </div>

  <div class="official-grid" id="officialGrid"></div>

  <div class="frame-legend">

    <h3>Official Frame System</h3>

    <div class="legend-grid">

      <div class="legend-item">
        <div class="legend-swatch swatch-gold"></div>
        Gold — National Executive
      </div>

      <div class="legend-item">
        <div class="legend-swatch swatch-silver"></div>
        Silver — Federal / Statewide
      </div>

      <div class="legend-item">
        <div class="legend-swatch swatch-bronze"></div>
        Bronze — Regional
      </div>

      <div class="legend-item">
        <div class="legend-swatch swatch-wood"></div>
        Wood — Local
      </div>

      <div class="legend-item">
        <div class="legend-swatch swatch-clear"></div>
        Clear — Community
      </div>

    </div>

  </div>

</section>

<section>

  <div class="section-heading">
    <h2>Know Their Power</h2>
    <p>
      Government offices have different responsibilities and legal powers.
    </p>
  </div>

  <div class="power-grid">

    <article class="power-card">
      <div>💰</div>
      <h3>Budget Power</h3>
      <p>
        Understand how an office participates in government spending and budgets.
      </p>
    </article>

    <article class="power-card">
      <div>🏛️</div>
      <h3>Lawmaking Power</h3>
      <p>
        Learn whether an office creates, votes on, signs, or enforces laws.
      </p>
    </article>

    <article class="power-card">
      <div>⚖️</div>
      <h3>Legal Authority</h3>
      <p>
        See what the office can legally do and what its limitations are.
      </p>
    </article>

    <article class="power-card">
      <div>📌</div>
      <h3>Appointment Power</h3>
      <p>
        Understand which positions the office can appoint or nominate.
      </p>
    </article>

    <article class="power-card">
      <div>🚨</div>
      <h3>Public Safety</h3>
      <p>
        Learn about responsibilities involving emergency services and public safety.
      </p>
    </article>

  </div>

</section>

</main>

<div class="modal" id="profileModal">

  <div class="modal-content">

    <div class="modal-header">

      <div>
        <div class="office" id="modalOffice"></div>
        <h2 id="modalName"></h2>
      </div>

      <button class="modal-close" onclick="closeProfile()">×</button>

    </div>

    <div id="modalBody"></div>

  </div>

</div>

<footer>

  <div class="footer-inner">

    <h2>Know Your Government</h2>

    <p>
      This project is designed to make government easier to understand
      by connecting people with the offices, districts, and officials
      that serve their communities.
    </p>

    <p>
      Official information is supplied by the Google Civic Information API
      where available.
    </p>

  </div>

</footer>

<script>

const WORKER_URL = "https://YOUR-WORKER-NAME.YOUR-SUBDOMAIN.workers.dev";

/*
 * This pulls the REAL SVG from your own GitHub project.
 * It means we don't replace your map with squares.
 */
const MAP_SOURCE =
  "https://raw.githubusercontent.com/shaki-fox/Know-Your-Chain-Of-Command/main/index.html";

const states = [
  ["AL","Alabama"],["AK","Alaska"],["AZ","Arizona"],["AR","Arkansas"],
  ["CA","California"],["CO","Colorado"],["CT","Connecticut"],
  ["DE","Delaware"],["FL","Florida"],["GA","Georgia"],
  ["HI","Hawaii"],["ID","Idaho"],["IL","Illinois"],["IN","Indiana"],
  ["IA","Iowa"],["KS","Kansas"],["KY","Kentucky"],["LA","Louisiana"],
  ["ME","Maine"],["MD","Maryland"],["MA","Massachusetts"],
  ["MI","Michigan"],["MN","Minnesota"],["MS","Mississippi"],
  ["MO","Missouri"],["MT","Montana"],["NE","Nebraska"],
  ["NV","Nevada"],["NH","New Hampshire"],["NJ","New Jersey"],
  ["NM","New Mexico"],["NY","New York"],["NC","North Carolina"],
  ["ND","North Dakota"],["OH","Ohio"],["OK","Oklahoma"],
  ["OR","Oregon"],["PA","Pennsylvania"],["RI","Rhode Island"],
  ["SC","South Carolina"],["SD","South Dakota"],["TN","Tennessee"],
  ["TX","Texas"],["UT","Utah"],["VT","Vermont"],["VA","Virginia"],
  ["WA","Washington"],["WV","West Virginia"],["WI","Wisconsin"],
  ["WY","Wyoming"]
];

const stateByCode = Object.fromEntries(
  states.map(([code,name]) => [
    code,
    {code,name}
  ])
);

let selectedState = null;
let selectedLevel = "federal";
let currentOfficials = [];

/* ---------------------------
   BASIC HELPERS
---------------------------- */

function esc(value){
  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function showStatus(message,error=false){

  const status = document.getElementById("status");

  status.hidden = false;
  status.textContent = message;
  status.className = error
    ? "status error"
    : "status";
}

function scrollToSearch(){
  document
    .getElementById("search")
    .scrollIntoView({
      behavior:"smooth",
      block:"start"
    });
}

function scrollToMap(){
  document
    .getElementById("states")
    .scrollIntoView({
      behavior:"smooth",
      block:"start"
    });
}

/* ---------------------------
   LOAD REAL MAP
---------------------------- */

async function loadRealMap(){

  const container = document.getElementById("mapContainer");

  try{

    const response = await fetch(
      MAP_SOURCE,
      {
        cache:"no-store"
      }
    );

    if(!response.ok){
      throw new Error("Map download failed");
    }

    const html = await response.text();

    const start = html.indexOf("<svg");

    const end = html.lastIndexOf("</svg>");

    if(start === -1 || end === -1){
      throw new Error("SVG map was not found");
    }

    const svgText =
      html.substring(
        start,
        end + "</svg>".length
      );

    container.innerHTML = svgText;

    const svg = container.querySelector("svg");

    if(!svg){
      throw new Error("SVG failed to load");
    }

    svg.id = "usMap";

    prepareMap(svg);

  }catch(error){

    console.error(error);

    container.innerHTML = `
      <div style="
        padding:80px 20px;
        text-align:center;
        color:#9b3f3f;
      ">
        <strong>Map could not be loaded.</strong>
        <br><br>
        Please make sure your GitHub repository is public.
      </div>
    `;

  }

}

/* ---------------------------
   PREPARE STATE MAP
---------------------------- */

function prepareMap(svg){

  const statePaths = [];

  svg.querySelectorAll("path").forEach(path => {

    const code = path.id;

    /*
     * ONLY IDs that are actual state codes
     * become clickable.
     *
     * This prevents path67 and other decorative
     * SVG paths from becoming weird clickable shapes.
     */

    if(!stateByCode[code]){
      path.style.pointerEvents = "none";
      return;
    }

    statePaths.push(path);

    path.classList.add("state-clickable");

    path.setAttribute(
      "tabindex",
      "0"
    );

    path.setAttribute(
      "role",
      "button"
    );

    path.setAttribute(
      "aria-label",
      stateByCode[code].name
    );

    path.addEventListener(
      "click",
      () => selectState(code,"map")
    );

    path.addEventListener(
      "keydown",
      event => {

        if(
          event.key === "Enter" ||
          event.key === " "
        ){

          event.preventDefault();

          selectState(code,"map");

        }

      }
    );

  });

  if(statePaths.length === 0){

    console.error(
      "No state paths found in SVG."
    );

    return;

  }

  console.log(
    "Interactive states loaded:",
    statePaths.length
  );

}

/* ---------------------------
   SELECT STATE
---------------------------- */

function selectState(
  code,
  source="map",
  place=""
){

  const state = stateByCode[code];

  if(!state){
    return;
  }

  selectedState = code;

  document
    .querySelectorAll(
      "#mapContainer svg path.state-clickable"
    )
    .forEach(path => {

      path.classList.remove(
        "selected",
        "zip-selected"
      );

      if(path.id === code){

        path.classList.add(
          source === "zip"
            ? "zip-selected"
            : "selected"
        );

      }

    });

  document.getElementById(
    "stateCode"
  ).textContent = code;

  document.getElementById(
    "stateTitle"
  ).textContent = state.name;

  document
    .getElementById("statePanel")
    .classList.add("visible");

  /*
   * If this was a map click, show
   * the selected state's existing data
   * until an address lookup is performed.
   */

  if(source === "map"){

    renderStateMessage(state);

  }

  if(source === "zip"){

    const result =
      document.getElementById(
        "locationResult"
      );

    result.innerHTML =
      "<strong>📍 Location found</strong><br>" +
      esc(place || "Address") +
      ", " +
      esc(state.name) +
      " (" +
      esc(code) +
      ")";

    result.classList.add("show");

  }

  setTimeout(() => {

    document
      .getElementById("statePanel")
      .scrollIntoView({
        behavior:"smooth",
        block:"start"
      });

  },50);

}

/* ---------------------------
   STATE MESSAGE
---------------------------- */

function renderStateMessage(state){

  const grid =
    document.getElementById(
      "officialGrid"
    );

  grid.innerHTML = `
    <article class="official-card">
      <div class="official-body">
        <div class="office">
          ${esc(state.name)}
        </div>

        <h3 class="official-name">
          Enter your address
        </h3>

        <p class="district">
          Google Civic Information will identify
          the officials serving that address.
        </p>

        <button
          class="primary"
          type="button"
          onclick="scrollToSearch()"
        >
          FIND MY GOVERNMENT
        </button>
      </div>
    </article>
  `;

}

/* ---------------------------
   GOOGLE CIVIC API
---------------------------- */

async function lookupGovernment(address){

  showStatus(
    "Finding the government officials serving this address…"
  );

  try{

    const response = await fetch(
      WORKER_URL + "/representatives",
      {
        method:"POST",

        headers:{
          "Content-Type":"application/json"
        },

        body:JSON.stringify({
          address:address
        })
      }
    );

    const data = await response.json();

    if(!response.ok){

      throw new Error(
        data.error ||
        "Government lookup failed."
      );

    }

    if(
      !data ||
      !Array.isArray(data.offices) ||
      !Array.isArray(data.officials)
    ){

      throw new Error(
        "The government API returned an unexpected response."
      );

    }

    currentOfficials = convertGoogleData(data);

    renderOfficials();

    showStatus(
      "Government information found."
    );

    return data;

  }catch(error){

    console.error(error);

    showStatus(
      error.message ||
      "Unable to retrieve government information.",
      true
    );

  }

}

/* ---------------------------
   CONVERT GOOGLE DATA
---------------------------- */

function convertGoogleData(data){

  const result = [];

  const offices = data.offices || [];

  const officials = data.officials || [];

  offices.forEach(office => {

    const indices =
      Array.isArray(office.officialIndices)
        ? office.officialIndices
        : [];

    indices.forEach(index => {

      const official =
        officials[index];

      if(!official){
        return;
      }

      const roles =
        Array.isArray(office.roles)
          ? office.roles
          : [];

      let level = "federal";

      if(
        roles.includes(
          "schoolBoard"
        )
      ){

        level = "school";

      }else if(
        roles.includes(
          "specialPurposeOfficer"
        )
      ){

        level = "special";

      }else if(
        roles.includes(
          "legislatorUpperBody"
        ) ||
        roles.includes(
          "legislatorLowerBody"
        ) ||
        roles.includes(
          "headOfGovernment"
        ) ||
        roles.includes(
          "governmentOfficer"
        )
      ){

        /*
         * Google gives the actual office.
         * We use the office name to make
         * the display level more useful.
         */

        const name =
          String(
            office.name || ""
          ).toLowerCase();

        if(
          name.includes("county")
        ){

          level = "county";

        }else if(
          name.includes("mayor") ||
          name.includes("city") ||
          name.includes("town")
        ){

          level = "local";

        }else if(
          name.includes("governor") ||
          name.includes("attorney general") ||
          name.includes("secretary of state") ||
          name.includes("state ")
        ){

          level = "state";

        }else{

          level = "federal";

        }

      }

      result.push({

        level:level,

        office:office.name ||
          "Government Office",

        name:official.name ||
          "Official",

        party:official.party ||
          "Not listed",

        photo:official.photoUrl ||
          "",

        phones:Array.isArray(
          official.phones
        )
          ? official.phones
          : [],

        emails:Array.isArray(
          official.emails
        )
          ? official.emails
          : [],

        urls:Array.isArray(
          official.urls
        )
          ? official.urls
          : [],

        roles:roles,

        district:
          getDistrict(
            data,
            office
          )

      });

    });

  });

  return result;

}

/* ---------------------------
   DISTRICT
---------------------------- */

function getDistrict(
  data,
  office
){

  const indices =
    Array.isArray(
      office.officialIndices
    )
      ? office.officialIndices
      : [];

  /*
   * Try to find a useful
   * division name.
   */

  const divisions =
    data.divisions || {};

  const names =
    Object.values(
      divisions
    )
    .map(
      division =>
        division &&
        division.name
    )
    .filter(Boolean);

  if(names.length){
    return names[0];
  }

  return "District information returned by Google";

}

/* ---------------------------
   RENDER OFFICIALS
---------------------------- */

function renderOfficials(){

  const grid =
    document.getElementById(
      "officialGrid"
    );

  grid.innerHTML = "";

  const filtered =
    currentOfficials.filter(
      official =>
        official.level ===
        selectedLevel
    );

  if(filtered.length === 0){

    grid.innerHTML = `
      <article class="official-card">

        <div class="official-body">

          <div class="office">
            ${esc(selectedLevel)}
          </div>

          <h3 class="official-name">
            No officials returned
          </h3>

          <p class="district">
            Google did not return an official
            for this category for the selected address.
          </p>

        </div>

      </article>
    `;

    return;

  }

  filtered.forEach(
    official => {

      const card =
        document.createElement(
          "article"
        );

      card.className =
        "official-card";

      const tier =
        getTier(
          official.level
        );

      card.innerHTML = `

        <div class="
          photo-frame
          frame-${tier}
        ">

          <div class="photo-inner">

            ${
              official.photo
                ? `
                  <img
                    src="${esc(official.photo)}"
                    alt="${esc(official.name)}"
                    onerror="
                      this.style.display='none';
                      this.parentElement.textContent='${esc(initials(official.name))}';
                    "
                  >
                `
                : esc(
                    initials(
                      official.name
                    )
                  )
            }

          </div>

        </div>

        <div class="official-body">

          <div class="office">
            ${esc(official.office)}
          </div>

          <h3 class="official-name">
            ${esc(official.name)}
          </h3>

          <p class="district">
            ${esc(official.district)}
          </p>

          <span class="party">
            <span class="party-dot"></span>
            ${esc(official.party)}
          </span>

          <div>
            <span class="
              tier
              tier-${tier}
            ">
              ${esc(
                tierName(tier)
              )}
            </span>
          </div>

          <div class="official-footer">

            <small>
              ${official.phones.length
                ? esc(
                    official.phones[0]
                  )
                : "Contact information available in profile"
              }
            </small>

            <button
              class="profile-button"
              type="button"
            >
              View profile →
            </button>

          </div>

        </div>
      `;

      card
        .querySelector(
          ".profile-button"
        )
        .addEventListener(
          "click",
          () => openProfile(official)
        );

      grid.appendChild(card);

    }
  );

}

/* ---------------------------
   TIERS
---------------------------- */

function getTier(level){

  switch(level){

    case "federal":
      return "silver";

    case "state":
      return "silver";

    case "county":
      return "bronze";

    case "local":
      return "wood";

    case "school":
      return "clear";

    case "special":
      return "clear";

    default:
      return "silver";

  }

}

function tierName(tier){

  switch(tier){

    case "gold":
      return "Gold — National Executive";

    case "silver":
      return "Silver — Federal / Statewide";

    case "bronze":
      return "Bronze — Regional / District";

    case "wood":
      return "Wood — Local Government";

    case "clear":
      return "Clear — Community / Special District";

    default:
      return "Government Official";

  }

}

/* ---------------------------
   PROFILE
---------------------------- */

function initials(name){

  return String(name || "Official")
    .trim()
    .split(/\s+/)
    .map(
      word =>
        word[0] || ""
    )
    .slice(0,2)
    .join("")
    .toUpperCase();

}

function openProfile(official){

  const tier =
    getTier(
      official.level
    );

  document.getElementById(
    "modalOffice"
  ).textContent =
    official.office;

  document.getElementById(
    "modalName"
  ).textContent =
    official.name;

  const phone =
    official.phones.length
      ? official.phones
          .map(
            phone =>
              `<div>${esc(phone)}</div>`
          )
          .join("")
      : "Not provided";

  const email =
    official.emails.length
      ? official.emails
          .map(
            email =>
              `<div>${esc(email)}</div>`
          )
          .join("")
      : "Not provided";

  const website =
    official.urls.length
      ? official.urls
          .map(
            url =>
              `<div>
                <a
                  href="${esc(url)}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Official website
                </a>
              </div>`
          )
          .join("")
      : "Not provided";

  document.getElementById(
    "modalBody"
  ).innerHTML = `

    <div class="
      modal-frame-preview
      photo-frame
      frame-${tier}
    ">

      <div class="photo-inner">

        ${
          official.photo
            ? `
              <img
                src="${esc(official.photo)}"
                alt="${esc(official.name)}"
              >
            `
            : esc(
                initials(
                  official.name
                )
              )
        }

      </div>

    </div>

    <p>
      <strong>Office:</strong>
      ${esc(official.office)}
    </p>

    <p>
      <strong>District:</strong>
      ${esc(official.district)}
    </p>

    <p>
      <strong>Political affiliation:</strong>
      ${esc(official.party)}
    </p>

    <p>
      <strong>Phone:</strong>
      ${phone}
    </p>

    <p>
      <strong>Email:</strong>
      ${email}
    </p>

    <p>
      <strong>Website:</strong>
      ${website}
    </p>

    <hr>

    <p>
      This information was returned by the
      Google Civic Information API for the
      searched address.
    </p>
  `;

  document
    .getElementById(
      "profileModal"
    )
    .classList.add("visible");

}

function closeProfile(){

  document
    .getElementById(
      "profileModal"
    )
    .classList.remove(
      "visible"
    );

}

document
  .getElementById(
    "profileModal"
  )
  .addEventListener(
    "click",
    event => {

      if(
        event.target.id ===
        "profileModal"
      ){

        closeProfile();

      }

    }
  );

/* ---------------------------
   TABS
---------------------------- */

document
  .querySelectorAll(
    ".gov-tab"
  )
  .forEach(
    tab => {

      tab.addEventListener(
        "click",
        () => {

          document
            .querySelectorAll(
