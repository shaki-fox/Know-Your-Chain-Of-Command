/* ---------------------------
   ADDRESS SEARCH
---------------------------- */

document
  .getElementById(
    "addressForm"
  )
  .addEventListener(
    "submit",
    async event => {

      event.preventDefault();

      const street =
        document
          .getElementById(
            "streetInput"
          )
          .value
          .trim();

      const city =
        document
          .getElementById(
            "cityInput"
          )
          .value
          .trim();

      const state =
        document
          .getElementById(
            "stateInput"
          )
          .value
          .trim()
          .toUpperCase();

      const zip =
        document
          .getElementById(
            "zipInput"
          )
          .value
          .trim();

      if(
        !street ||
        !city ||
        !/^[A-Z]{2}$/.test(state) ||
        !/^\d{5}$/.test(zip)
      ){

        showStatus(
          "Enter a street address, city, two-letter state, and 5-digit ZIP code.",
          true
        );

        return;

      }

      const address =
        `${street}, ${city}, ${state} ${zip}`;

      await lookupGovernment(
        address
      );

      /*
       * Highlight the state
       * on the map.
       */

      if(
        stateByCode[state]
      ){

        selectState(
          state,
          "zip",
          `${street}, ${city}`
        );

      }

    }
  );

